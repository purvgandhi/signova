# ==============================================================================
# Signova / SignBridge Studio — Environment Configuration Template
# ==============================================================================
# NOTE: Replace placeholder values with your actual credentials.
# Do NOT commit production secrets to public source control.

# Google Gemini Small Language Model (SLM) API Key
# Used as dynamic fallback when gesture sequence is not in local_sentences.json
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
